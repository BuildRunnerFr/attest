# --- Modèles -----------------------------------------------------------------
# meta  : Meta Model API · local : Muse Glimmer servi par toi · mock : sans clé
ATTEST_BACKEND=meta
MODEL_API_KEY=
ATTEST_MODEL_REASON=muse-spark-1.3
ATTEST_MODEL_CODE=muse-spark-1.3
# Backend local (serveur compatible OpenAI : llama.cpp llama-server, vLLM, SGLang)
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=muse-glimmer

# --- Mission -----------------------------------------------------------------
ATTEST_LANG=fr                 # en pour la vidéo du jury
ATTEST_AUDITOR="A. Auditeur"   # ton nom (auditeur responsable)
ATTEST_APPROVER="Responsable IAM (démo)"   # propriétaire du système : approuve les changements
ATTEST_WORKERS=6               # contrôles en parallèle (baisser si l'API renvoie 429)

# --- Console auditée (comptes de service de démo) ------------------------------
LAB_AUDIT_TOKEN=audit-ro-demo
LAB_CHANGE_TOKEN=change-rw-demo
# Si l'API refuse les images en data: URL, URL publique qui sert le dossier runs/
PUBLIC_EVIDENCE_BASE_URL=
